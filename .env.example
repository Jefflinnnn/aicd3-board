# Copy to .env (never commit .env). `neon deploy` / `neon env pull` fill in the Neon values.

# --- written by `neon deploy` -------------------------------------------------------------
# Pooled connection for the app (hostname contains -pooler)
DATABASE_URL=
# Direct connection for Prisma migrations
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=

# --- yours to set -------------------------------------------------------------------------
# Signs the session cookie. Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Who may sign in at all (comma-separated; subdomains included). Default: ucsf.edu
SIGN_IN_EMAIL_DOMAINS=ucsf.edu

# Optional. Verified addresses at these domains become active students on first sign-in,
# e.g. "ucsf.edu". Leave empty to have staff approve each new account on the Admin page.
AUTO_APPROVE_EMAIL_DOMAINS=

# Lets the scraper post to /api/ingest. At least 32 characters: openssl rand -hex 32
SCRAPER_INGEST_TOKEN=
