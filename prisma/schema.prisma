// AICD3 Job Board database.
//
// People sign in through Neon Auth (Google). Neon Auth keeps its own tables in the
// `neon_auth` schema; this app keeps one Profile per signed-in person, keyed by the
// Neon Auth user id, with the role and access status the app checks on every request.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// What a person can do. Students read postings and keep their own lists; staff also run the
/// review queue, edit postings and see requests and reports; admins also manage people.
enum Role {
  student
  staff
  admin
}

/// Whether a signed-in person may use the app yet.
enum AccessStatus {
  pending
  active
  blocked
}

/// Where a posting sits: on the job board, waiting for staff review, rejected by staff
/// (kept so later imports don't send it back), or in the bin (purged after 30 days).
enum PostingState {
  live
  review
  rejected
  bin
}

enum MyStatus {
  saved
  applied
}

model Profile {
  /// Neon Auth user id
  id        String       @id
  /// lower-case, from the sign-in provider
  email     String
  /// whether the sign-in provider verified the address (Google does)
  emailVerified Boolean  @default(false)
  name      String?
  role      Role         @default(student)
  status    AccessStatus @default(pending)
  /// previous visit, for "new since you were last here"
  lastVisit DateTime?
  /// this person's dashboard arrangement { order: string[], hidden: string[] }
  layout    Json?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  statuses JobStatus[]
  notes    JobNote[]
  requests CompanyRequest[]
  reports  IssueReport[]

  @@index([status])
  @@index([email])
}

/// Access decided before someone first signs in: staff invites and pre-approved students.
/// Applied (and removed) the first time a person with this verified email signs in.
model AccessGrant {
  /// lower-case email address
  email     String   @id
  role      Role     @default(student)
  grantedBy String?
  createdAt DateTime @default(now())
}

model Posting {
  id        String       @id
  /// internship (the job board) or job: a full-time role, shown only to PRIVATE_ROLES_EMAILS (the Full-time roles tab)
  kind      String       @default("internship")
  state     PostingState @default(live)
  title     String
  /// company id from lib/data.ts COMPANIES
  company   String
  /// primary location (older data); `locations` lists every site
  location  String
  locations String[]
  category  String
  /// first seen
  posted    DateTime     @db.Date
  /// null = rolling
  deadline  DateTime?    @db.Date
  term      String       @default("")
  /// earliest and latest month (1-12) the internship can start, read from the posting's text; null when it
  /// doesn't say ("10-12 weeks between May and August" is 5 to 7)
  startFrom Int?
  startTo   Int?
  /// full-time roles: "entry" (0-2 years) or "mid" (2-5 years), as d3 judged it; "" when unsure
  level     String       @default("")
  /// full-time roles: why d3 was unsure about it (they never go to the staff review queue)
  note      String       @default("")
  /// full-time roles: how well it fits (d3's fit probability, 0-100)
  score     Int?
  mode      String       @default("Onsite")
  pay       String       @default("")
  url       String
  /// the company's own job / requisition ID (e.g. R-254668); with `company`, how a posting is
  /// recognised from one scrape to the next even when its title or link changes
  reqId     String       @default("")
  summary   String       @default("")
  resp      String[]
  quals     String[]
  closed    Boolean      @default(false)
  sample    Boolean      @default(false)
  addedAt   DateTime?
  /// ReviewInfo while in review/rejected { flags, source, at, status, decidedAt? }
  review    Json?
  deletedAt DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  statuses JobStatus[]
  notes    JobNote[]

  @@index([state])
  @@index([company])
  @@index([company, reqId])
  @@index([kind, state])
}

model JobStatus {
  userId    String
  postingId String
  status    MyStatus
  updatedAt DateTime @updatedAt

  user    Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  posting Posting @relation(fields: [postingId], references: [id], onDelete: Cascade)

  @@id([userId, postingId])
}

model JobNote {
  userId    String
  postingId String
  text      String
  updatedAt DateTime @updatedAt

  user    Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  posting Posting @relation(fields: [postingId], references: [id], onDelete: Cascade)

  @@id([userId, postingId])
}

/// A student asking staff to track another company.
model CompanyRequest {
  id         String    @id
  userId     String
  name       String
  site       String    @default("")
  cat        String    @default("")
  email      String    @default("")
  why        String    @default("")
  date       String
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  resolvedBy String?

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([resolvedAt])
}

/// A problem a student flagged on a posting or the site.
model IssueReport {
  id         String    @id
  userId     String
  kind       String
  jobId      String    @default("")
  details    String    @default("")
  email      String    @default("")
  date       String
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  resolvedBy String?

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([resolvedAt])
}

/// Site-wide settings: one row, id 1.
model SiteMeta {
  id           Int       @id @default(1)
  customCats   Json      @default("[]")
  lastUpdated  DateTime?
  lastImport   Json?
  /// run the scraper pipeline on its own every `refreshHours` (Admin: Job data refresh)
  autoRefresh  Boolean   @default(false)
  refreshHours Int       @default(48)
  /// a refresh asked for on the Admin page of a server that can't run the scraper (the live site on Vercel):
  /// the GPU PC checks every few minutes (scraper/refresh_requests.ps1), takes it and runs it
  refreshRequestedAt DateTime?
  /// the staff member's profile id
  refreshRequestedBy String?
  /// when the GPU PC last asked for requests (every 5 minutes while its task runs), and its computer name
  requestCheckAt   DateTime?
  requestCheckHost String?
}

enum ScrapeStatus {
  running
  succeeded
  partial
  failed
  cancelled
}

/// One run of scraper/pipeline.py started from the Admin page or the schedule.
model ScrapeRun {
  id          String       @id @default(cuid())
  /// manual | schedule
  trigger     String
  requestedBy String?
  status      ScrapeStatus @default(running)
  startedAt   DateTime     @default(now())
  finishedAt  DateTime?
  /// process id while running, so a run can be stopped or found dead after a restart
  pid         Int?
  /// counts and per-company results from the pipeline's --summary-json
  summary     Json?
  /// the last lines the pipeline printed
  log         String       @default("")

  @@index([startedAt])
  @@index([status])
}

/// Who changed access or bulk-loaded postings, and when.
model AuditLog {
  id      String   @id @default(cuid())
  actorId String?
  action  String
  target  String?
  detail  Json?
  at      DateTime @default(now())

  @@index([at])
}
